<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 6.0-c002 79.164488, 2020/07/10-22:06:53        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:Iptc4xmpCore="http://iptc.org/std/Iptc4xmpCore/1.0/xmlns/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
   Iptc4xmpCore:Location="Tlogopakis Village"
   dc:format="image/jpeg"
   exif:DateTimeOriginal="2020-10-06T11:27:29"
   photoshop:City="Pekalongan District"
   photoshop:Country="Indonesia"
   photoshop:Credit="Â© UNICEF/UN0353564/Ijazah"
   photoshop:DateCreated="2020-10-06T11:27:29"
   photoshop:State="Central Java"
   xmpRights:Marked="True">
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Fauzan Ijazah</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Wahyu washes her son's clothes in a newly constructed sanitation facility in her home in Tlogopakis village, Central Java province, Indonesia. Tlogopakis is in a remote area that sits 1,300 meters above sea level. Most of its residents are low-income, and many did not previously have toilets or basic sanitation facilities in their homes.&#xA;&#xA;Safe sanitation is vital to health, child development and social and economic progress. It is also a human right - essential for the fulfilment of child rights and achievement of good physical, mental and social well-being. SDG 6 commits the world to achieving basic sanitation for all by 2030. &#xA;&#xA;The Government of Indonesia has made universal access to sanitation a priority in an effort to reduce the rate of stunting among children. In 2020, the Ministry of Public Works and Housing began implementing a sanitation programme, funded through the state budget, to construct clean water and sanitation facilities for low-income communities and households with pregnant women, toddlers, stunted children and persons with disabilities.&#xA;&#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Fauzan Ijazah</rdf:li>
    </rdf:Alt>
   </dc:rights>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

endstream
