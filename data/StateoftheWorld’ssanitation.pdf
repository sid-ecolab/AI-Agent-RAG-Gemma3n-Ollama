     <rdf:li>boy</rdf:li>
     <rdf:li>children in conflict and emergencies</rdf:li>
     <rdf:li>girl</rdf:li>
     <rdf:li>latrine</rdf:li>
     <rdf:li>living conditions</rdf:li>
     <rdf:li>refugee</rdf:li>
    </rdf:Bag>
   </dc:subject>
