   <dc:creator>
    <rdf:Seq>
     <rdf:li>KAREL PRINSLOO</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A pupil walk past the newly toilets build by Unicef at the  primary school in the small village of Sintchan-Farba, Guinea Bissau, Thursday 16, January 2020.  Unicef  is helping the community in supporting the school with primary education , wash, school farming , menstrual hygiene management and early childhood development.Photo/Prinsloo&#xA;&#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">KAREL PRINSLOO</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <Iptc4xmpExt:Event>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">UNICEF GUINEA BISSAU SINTCHAN FABRA</rdf:li>
    </rdf:Alt>
   </Iptc4xmpExt:Event>
  </rdf:Description>
