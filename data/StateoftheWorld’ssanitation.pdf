    </rdf:Alt>
   </dc:rights>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>boy</rdf:li>
     <rdf:li>girl</rdf:li>
     <rdf:li>hand-washing</rdf:li>
     <rdf:li>latrine</rdf:li>
     <rdf:li>WASH</rdf:li>
     <rdf:li>water and sanitation</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Sutarajpur, Rayagada.</rdf:li>
    </rdf:Alt>
   </dc:title>
