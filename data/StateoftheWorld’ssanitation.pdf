     <rdf:li>girl</rdf:li>
     <rdf:li>latrine</rdf:li>
     <rdf:li>men</rdf:li>
     <rdf:li>water and sanitation</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <photoshop:SupplementalCategories>
    <rdf:Bag>
     <rdf:li>20150716_UNICEF_Bolivia_0343.jpg</rdf:li>
