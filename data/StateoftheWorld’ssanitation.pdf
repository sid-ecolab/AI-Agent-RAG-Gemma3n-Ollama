<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 6.0-c002 79.164488, 2020/07/10-22:06:53        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
   dc:format="image/jpeg"
   exif:DateTimeOriginal="2019-04-04T12:12:58"
   photoshop:Credit="Â© UNICEF/UN0306431/Abdul"
   photoshop:DateCreated="2019-04-04">
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Zahara Abdul </rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Health workers use the newly constructed latrines with handwashing facilities at Karenga Health centre IV, Kaabong District.  &#xA;&#xA;UNICEF with funding from KOICA is upgrading water, sanitation and hygiene facilities in health centres in the Karamoja sub-region to improve the quality of health care. A such, water has been extended to critical areas like laboratories, labour wards, theatres, among others to control infections and improve hygiene.&#xA;&#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Health</rdf:li>
     <rdf:li>health centre</rdf:li>
     <rdf:li>health education</rdf:li>
     <rdf:li>health promotion</rdf:li>
     <rdf:li>hygiene</rdf:li>
     <rdf:li>maternal health</rdf:li>
     <rdf:li>medical personnel</rdf:li>
     <rdf:li>mother</rdf:li>
     <rdf:li>newborn health</rdf:li>
     <rdf:li>WASH</rdf:li>
     <rdf:li>water supply</rdf:li>
    </rdf:Bag>
   </dc:subject>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

