<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 6.0-c002 79.164488, 2020/07/10-22:06:53        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
   dc:format="image/jpeg"
   exif:DateTimeOriginal="2016-09-06T12:35:29"
   photoshop:Country="Ecuador"
   photoshop:Credit="Â© UNICEF/UN033691/Arcos"
   photoshop:DateCreated="2016-09-06">
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Santiago Arcos</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Baterias sanitarias rehabilitadas en la unidad educativa Mercedes Mendoza Briones de la comunidad Estero Seco como parte del programa WASH bajo el marco de respuesta de emergencia de Unicef en las zonas afectadas por el terremoto de 7.8 del 16 de abril del 2016. /  / Rehabilitated bathrooms in the school Mercedes Mendoza Briones of the Estero Seco Comunity are part of the WASH program that envolves the emergency response by Unicef due to the 7.8 earthquake that hit Ecuador on april 16th, 2016.&#xA;&#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>6 to 11 years old</rdf:li>
     <rdf:li>girl</rdf:li>
     <rdf:li>latrine</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <photoshop:SupplementalCategories>
    <rdf:Bag>
     <rdf:li>Unicef_SantiagoArcos-5931.JPG</rdf:li>
    </rdf:Bag>
   </photoshop:SupplementalCategories>
  </rdf:Description>
 </rdf:RDF>
