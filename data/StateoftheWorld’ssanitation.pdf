<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 6.0-c002 79.164488, 2020/07/10-22:06:53        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:Iptc4xmpCore="http://iptc.org/std/Iptc4xmpCore/1.0/xmlns/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
   Iptc4xmpCore:CountryCode="IND"
   dc:format="image/jpeg"
   exif:DateTimeOriginal="2009-10-24T11:33:31"
   photoshop:CaptionWriter="Tom Pietrasik"
   photoshop:ColorMode="3"
   photoshop:Country="INDIA"
   photoshop:Credit="Â© UNICEF/UNI79278/Pietrasik"
   photoshop:DateCreated="2009-10-24T11:33:31+05:30"
   photoshop:ICCProfile="sRGB IEC61966-2.1"
   photoshop:State="West Bengal"
   xmpRights:Marked="True">
   <dc:creator>
    <rdf:Seq>
     <rdf:li>TOM PIETRASIK</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Women at the rural development unit of the Ramakrishna Mission ashram at Dakshin Dhalhara construct iron-removal filters for use in households and schools. The latrine-construction unit serves four blocks in Purbamedinipur district: Shahid Matangini, Nanda Kumar, Panskura and Tamluk. UNICEF provides techincal training and finance to support the unit. These women are employed as day-wage labour for this task by UNICEF partners the Ramakrishna Mission Lokasiksha Parishad.&#xA;&#xA;Photo: Tom Pietrasik&#xA;Purbamedinipur District, West Bengal. India&#xA;October 24th 2009&#xA;&#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">UNICEF INDIA/TOM PIETRASIK</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>latrine</rdf:li>
     <rdf:li>rural area</rdf:li>
     <rdf:li>water and sanitation</rdf:li>
     <rdf:li>women</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <photoshop:SupplementalCategories>
    <rdf:Bag>
     <rdf:li>WASH A 002.jpg</rdf:li>
    </rdf:Bag>
   </photoshop:SupplementalCategories>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

