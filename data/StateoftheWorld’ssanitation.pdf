<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 6.0-c002 79.164488, 2020/07/10-22:06:53        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
   dc:format="image/jpeg"
   exif:DateTimeOriginal="2015-11-11T10:32:53"
   photoshop:Credit="Â© UNICEF/UN040195/"
   photoshop:DateCreated="2015-11-11">
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Handwashing with soap is among the most effective and inexpensive ways to prevent diarrheal diseases and pneumonia. This children are learning how to do it properly at the kindergarten. The photo was made during the field visit to document the best practices of pre-school education in Belarus.&#xA;&#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>1 to 5 years old</rdf:li>
     <rdf:li>early childhood</rdf:li>
     <rdf:li>hand-washing</rdf:li>
     <rdf:li>pre-school</rdf:li>
    </rdf:Bag>
   </dc:subject>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

