<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 6.0-c002 79.164488, 2020/07/10-22:06:53        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
   dc:format="image/jpeg"
   exif:DateTimeOriginal="2020-10-06T08:14:21"
   photoshop:ColorMode="3"
   photoshop:Country="Indonesia"
   photoshop:Credit="Â© UNICEF/UN0352551/Ose"
   photoshop:DateCreated="2020-10-06T08:14:21"
   photoshop:ICCProfile="Adobe RGB (1998)">
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Jiro Ose</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">On 6 October 2020, Andrea Sucipto, head of the Wastewater Management Unit at the Wetland-Biocord Wastewater Treatment Plant (IPAL BIOCORD POLDER GALAXY) in Bekasi, Indonesia, sits next to aeration pumps. Residential wastewater is piped to the plant from some 2,200 houses in the surrounding area, where it is aerated and run through biofilters before being released to a retention pool, or â€˜polder, then eventually into Bekasi River. This is the only facility of its calibre in Bekasi, a commuter city within the Jakarta metropolitan area with more than 600,000 households and a population of nearly 3 million, though there is another one currently being constructed.&#xA;&#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>WASH</rdf:li>
     <rdf:li>water and sanitation</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <photoshop:SupplementalCategories>
    <rdf:Bag>
     <rdf:li>DSCF5925.jpg</rdf:li>
    </rdf:Bag>
   </photoshop:SupplementalCategories>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

