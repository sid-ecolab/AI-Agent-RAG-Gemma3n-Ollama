     <rdf:li>father</rdf:li>
     <rdf:li>labour</rdf:li>
     <rdf:li>latrine</rdf:li>
     <rdf:li>men</rdf:li>
     <rdf:li>urban area</rdf:li>
     <rdf:li>WASH</rdf:li>
     <rdf:li>water and sanitation</rdf:li>
    </rdf:Bag>
